{
  "name": "spotify-library-mcp",
  "version": "1.3.0",
  "description": "Local MCP server + CLI for managing your own Spotify library and playlists",
  "type": "module",
  "bin": {
    "spot": "bin/spot.js"
  },
  "scripts": {
    "auth": "node scripts/auth.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:mock": "node test/mock-spotify.js",
    "start:http": "node src/http.js",
    "tunnel": "bash scripts/tunnel.sh",
    "pull": "node scripts/pull.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.23.8"
  },
  "license": "MIT",
  "repository": "github:oliver-virt/spotify-library-mcp"
}
